ATLAS_ENV=development              # anything other than "development" REFUSES to start with the default secret
ATLAS_DEBUG=false
# --- PostgreSQL is the primary supported database (SQLite is for lightweight local use only)
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas_core
ATLAS_REDIS_URL=redis://localhost:6379/0
# --- secrets: generate with  python -c "import secrets;print(secrets.token_urlsafe(48))"
ATLAS_SECRET_KEY=change-me
# --- authentication
ATLAS_ACCESS_TOKEN_TTL_SECONDS=900
ATLAS_REFRESH_TOKEN_TTL_SECONDS=604800
ATLAS_PASSWORD_HASH_ITERATIONS=600000
ATLAS_MAX_FAILED_LOGINS=5
ATLAS_LOCKOUT_SECONDS=900
ATLAS_RESET_TOKEN_TTL_SECONDS=3600
# --- rate limiting (redis = shared by all workers; memory = per-process, dev only)
ATLAS_RATE_LIMIT_BACKEND=redis
ATLAS_RATE_LIMIT_FAIL_MODE=memory   # memory | closed | open  (behaviour if Redis is unreachable)
ATLAS_RATE_LIMIT_PER_MINUTE=120
ATLAS_AUTH_RATE_LIMIT_PER_MINUTE=10 # login / refresh / password-reset, per client IP
ATLAS_TRUST_PROXY_HEADERS=false     # true ONLY behind a proxy you control (uses X-Forwarded-For)
# --- browser clients (comma separated)
ATLAS_CORS_ORIGINS=http://localhost:5173
# --- outbound safety
ATLAS_COLLECTOR_MIN_INTERVAL_SECONDS=1.0
ATLAS_MAX_REDIRECTS=3
ATLAS_ALLOWED_PORTS=80,443,8080,8443
# --- AI: none | anthropic | openai_compatible
ATLAS_AI_PROVIDER=none
ATLAS_AI_API_KEY=
ATLAS_AI_MODEL=claude-sonnet-4-6
ATLAS_AI_BASE_URL=
